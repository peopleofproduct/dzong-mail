// Unwalled Mail — local-first data model
// All data lives on the user's own PostgreSQL instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Local profile ────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  name        String?
  avatarPath  String?
  preferences Json    @default("{}")

  accounts        EmailAccount[]
  aiSettings      AISettings?
  automationRules AutomationRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Connected mailbox ────────────────────────────────────────────────────────

model EmailAccount {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  provider     MailProvider
  emailAddress String
  displayName  String?

  // Generic IMAP/SMTP configuration
  imapHost          String?
  imapPort          Int?
  imapSecurity      EncryptionType?
  smtpHost          String?
  smtpPort          Int?
  smtpSecurity      EncryptionType?
  username          String?
  passwordEncrypted String?

  // OAuth — user-supplied client credentials (BYOK)
  oauthClientId       String?
  oauthClientSecret   String?
  oauthAccessToken    String?
  oauthRefreshToken   String?
  oauthTokenExpiresAt DateTime?
  oauthScopes         String[]        @default([])

  // Synchronization state (historyId / delta token / UIDVALIDITY depending on provider)
  syncToken           String?
  lastSyncedAt        DateTime?
  syncEnabled         Boolean  @default(true)
  syncIntervalMinutes Int      @default(5)
  isActive            Boolean  @default(true)

  messages        Message[]
  calendarEvents  CalendarEvent[]
  automationRules AutomationRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, emailAddress])
  @@index([userId])
}

// ─── Synchronized message metadata ────────────────────────────────────────────

model Message {
  id               String       @id @default(cuid())
  emailAccount     EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailAccountId   String
  providerMessageId String
  threadId         String?
  folder           String?

  subject    String?
  snippet    String?
  fromAddress String
  fromName   String?
  toAddresses  String[] @default([])
  ccAddresses  String[] @default([])
  bccAddresses String[] @default([])
  headers    Json?
  sizeBytes  Int?

  bodyText   String?
  bodyHtml   String?
  // Message bodies/mime sources may also live on local disk; this points at the stored file.
  localBodyPath String?

  receivedAt   DateTime
  isRead       Boolean    @default(false)
  readAt       DateTime? // when the user first opened it (local read receipt)
  isStarred    Boolean    @default(false)
  isDraft      Boolean    @default(false)
  isArchived   Boolean    @default(false)
  snoozedUntil DateTime?
  scheduledAt  DateTime? // send-later for drafts
  receiptRequested Boolean @default(false) // sent with an MDN read-receipt request

  providerLabels String[] @default([])
  aiLabels       String[] @default([])
  labels         String[] @default([]) // user- and rule-applied labels
  aiSummary      String?

  hasAttachment Boolean      @default(false)
  attachments   Attachment[]
  calendarEvents CalendarEvent[]
  aiDecisions    AiDecision[]

  // Semantic-search vector — brute-force cosine at local scale, no pgvector needed.
  embedding      Float[] @default([])
  embeddingModel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emailAccountId, providerMessageId])
  @@index([emailAccountId, receivedAt])
  @@index([threadId])
  @@index([fromAddress])
}

model Attachment {
  id        String  @id @default(cuid())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String

  filename  String
  mimeType  String?
  sizeBytes Int?
  contentId String? // cid: for inline references

  // Path relative to the attachments dir (UNWALLED_DATA_DIR/attachments).
  // Null when only metadata was synced and the content was not downloaded.
  storagePath String?

  // Extracted plain text for searchable types (txt/md/csv/json/pdf...).
  contentText String?
  // sha256 of the bytes - dedupes the same file across threads.
  contentHash String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([contentHash])
}

// ─── AI routing configuration ─────────────────────────────────────────────────

model AISettings {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  provider        AIProvider @default(OLLAMA)
  baseUrl         String? // e.g. http://localhost:11434 — null falls back to the provider default
  apiKeyEncrypted String? // cloud BYOK, stored locally
  model           String   @default("llama3.1")
  embeddingModel  String?
  temperature     Float    @default(0.2)
  enabled         Boolean  @default(true)

  // User-defined classification categories, e.g.
  // [{ "name": "RECEIPTS", "prompt": "Invoices, receipts, or bills" }]
  customLabels Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Achievements ─────────────────────────────────────────────────────────────

// One row per local day the inbox was seen fully clear. Streaks are computed
// from consecutive day keys - history before tracking started is unknowable.
model InboxZeroDay {
  date      String   @id // YYYY-MM-DD (local day)
  createdAt DateTime @default(now())
}

// ─── User-defined automation ──────────────────────────────────────────────────

model AutomationRule {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Optional: scope the rule to one account; null applies it to all of the user's accounts
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailAccountId String?

  name        String
  description String?
  isEnabled   Boolean @default(true)
  priority    Int     @default(0)

  trigger   RuleTrigger    @default(ON_MESSAGE_SYNC)
  matchMode RuleMatchMode  @default(ALL)

  // e.g. [{ "field": "subject", "operator": "contains", "value": "invoice" },
  //       { "field": "aiLabel",  "operator": "equals",   "value": "newsletter" }]
  conditions Json

  // e.g. [{ "type": "ARCHIVE" }, { "type": "ADD_LABEL", "label": "Finance" },
  //       { "type": "DRAFT_REPLY", "template": "..." },
  //       { "type": "WEBHOOK", "value": "https://..." }]
  actions Json

  // When true, drafts created by this rule's DRAFT_REPLY action are
  // auto-queued through the send window instead of waiting for review.
  autoSendDrafts Boolean @default(false)

  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isEnabled, priority])
}

// ─── Local app state ──────────────────────────────────────────────────────────

// Activity surfaced to the user: new mail, follow-up reminders, send
// results, overnight-agent summaries. dedupeKey prevents repeat rows.
model Notification {
  id        String    @id @default(cuid())
  kind      String
  dedupeKey String?   @unique
  title     String
  body      String?
  messageId String?
  threadId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

// Composer templates the user can insert from the snippet picker.
model Snippet {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Local to-dos rendered on the calendar alongside mail-derived events.
model Task {
  id        String    @id @default(cuid())
  title     String
  notes     String?
  dueAt     DateTime?
  doneAt    DateTime?
  messageId String?
  createdAt DateTime  @default(now())

  @@index([dueAt])
}

// One row per background-worker cycle — the audit trail behind the
// "while you slept" morning briefing.
model AgentRun {
  id      String   @id @default(cuid())
  kind    String // "sync" | "maintenance"
  summary Json
  ranAt   DateTime @default(now())

  @@index([ranAt])
}

// Calendar events parsed out of inbound mail (.ics invites / text/calendar
// attachments). Local-only - rendered on /calendar, never synced back.
model CalendarEvent {
  id          String    @id @default(cuid())
  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailAccountId String
  message     Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId   String?
  uid         String // iCal UID - dedupes updates to the same invite
  summary     String?
  description String?
  location    String?
  organizer   String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("CONFIRMED") // CONFIRMED | TENTATIVE | CANCELLED
  attendees   String[]  @default([]) // ATTENDEE mailto addresses
  recurrence  String?   // raw RRULE value, kept for future expansion
  createdAt   DateTime  @default(now())

  @@unique([emailAccountId, uid])
  @@index([startsAt])
}

// Every AI- or rule-driven decision on a message, with reasoning the user
// can inspect. Confidence below the auto-apply threshold lands status
// "queued" in the review queue instead of being applied.
model AiDecision {
  id         String   @id @default(cuid())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  kind       String // "label" | "rule" | "draft" | "follow-up"
  action     String // the label applied, rule name, etc.
  reason     String? // why the AI/rule did this, in its own words
  confidence Float? // 0-1, null when the provider gave none
  status     String @default("applied") // "applied" | "queued" | "rejected"
  createdAt  DateTime @default(now())

  @@index([messageId])
  @@index([status, createdAt])
}

// User- and worker-driven mutations, logged so anything is auditable and
// reversible actions carry their inverse in `detail`.
model AuditEntry {
  id         String    @id @default(cuid())
  action     String // "archive" | "unarchive" | "star" | "read" | "trash" | "move" | "label" | "rule-apply" | "send" | ...
  targetType String // "message" | "thread" | "rule" | "task"
  targetId   String
  detail     Json? // inverse payload for reversible actions, e.g. {"setIsArchived": false}
  undoneAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// Key-value store for user preferences that are not AI settings:
// inbox split labels, notification preferences, undo-send window.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MailProvider {
  GOOGLE
  MICROSOFT
  IMAP_SMTP
  MOCK
  IMPORTED // messages imported from .eml/.mbox files - never synced or sent
}

enum EncryptionType {
  NONE
  SSL_TLS
  STARTTLS
}

enum AIProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
}

enum RuleTrigger {
  ON_MESSAGE_SYNC
  ON_AI_CLASSIFICATION
  MANUAL
}

enum RuleMatchMode {
  ALL
  ANY
}
